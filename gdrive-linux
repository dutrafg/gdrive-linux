    def refresh_mount_startup(self):
        self.mount_startup_switch.set_sensitive(False)
        self.mount_startup_status.set_text("Consultando ativação no systemd do usuário…")
        threading.Thread(target=self.mount_startup_check_worker, daemon=True).start()

    def mount_startup_check_worker(self):
        active = autostart_enabled()
        GLib.idle_add(self.mount_startup_update, active)

    def mount_startup_update(self, active):
        if self.mount_autostart_busy:
            return False
        self.restoring_mount_autostart = True
        self.mount_startup_switch.set_active(active)
        self.mount_autostart_on = active
        self.restoring_mount_autostart = False
        self.mount_startup_switch.set_sensitive(True)
        self.mount_startup_status.set_text(
            "Ativo: o disco virtual será montado ao entrar na sessão Linux. "
            "Se a rede estiver indisponível, o serviço tentará novamente."
            if active else
            "Desativado: o disco virtual será montado apenas quando solicitado.")
        return False

    def mount_startup_changed(self, switch, *_):
        if self.restoring_mount_autostart or self.mount_autostart_busy:
            return
        wanted = switch.get_active()
        if wanted:
            remote = self.selected_remote()
            if not remote:
                self.notice("Selecione uma conta em Contas primeiro.", "warning")
                self.restoring_mount_autostart = True
                switch.set_active(False)
                self.restoring_mount_autostart = False
                return
            config = {"account": remote, "folder": str(self.folder),
                      "mount_read_only": self.mount_read_only}
            try:
                mount_command(config, require_tools=True, create=False)
            except (ValueError, OSError, RuntimeError) as exc:
                self.notice(str(exc), "warning")
                self.restoring_mount_autostart = True
                switch.set_active(False)
                self.restoring_mount_autostart = False
                return
            self.persist()
        self.mount_autostart_busy = True
        switch.set_sensitive(False)
        self.mount_startup_status.set_text("Configurando inicialização automática…")
        threading.Thread(target=self.mount_startup_change_worker,
                         args=(wanted,), daemon=True).start()

    def mount_startup_change_worker(self, wanted):
        enabled, message = update_autostart(wanted)
        GLib.idle_add(self.mount_startup_change_complete, enabled, message, wanted)

    def mount_startup_change_complete(self, enabled, message, wanted):
        self.mount_autostart_busy = False
        self.restoring_mount_autostart = True
        self.mount_startup_switch.set_active(enabled)
        self.mount_autostart_on = enabled
        self.restoring_mount_autostart = False
        self.mount_startup_switch.set_sensitive(True)
        self.mount_startup_status.set_text(message)
        self.notice(message, "success" if enabled == wanted else "warning")
        self.refresh_mount_status()
        return False

