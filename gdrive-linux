        self.log.set_editable(False)
        self.log.set_monospace(True)
        scroll.set_child(self.log)
        self.path_parts = []
        browser_header = Gtk.Box(spacing=8)
        files_page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        files_page.append(browser_header)
        self.back_button = Gtk.Button(label="Voltar")
        self.back_button.connect("clicked", self.go_back)
        self.back_button.set_sensitive(False)
        browser_header.append(self.back_button)
        self.path_label = Gtk.Label(label="Meu Drive")
        self.path_label.set_hexpand(True)
        self.path_label.set_xalign(0)
        browser_header.append(self.path_label)
        reload_button = Gtk.Button(label="Ver arquivos")
        reload_button.connect("clicked", self.browse)
        browser_header.append(reload_button)
        self.files_list = Gtk.ListBox()
        self.files_list.connect("row-activated", self.open_folder)
        file_scroll = Gtk.ScrolledWindow()
        file_scroll.set_min_content_height(140)
        file_scroll.set_child(self.files_list)
        file_scroll.set_vexpand(True)
        files_page.append(file_scroll)
        log_label = Gtk.Label(label="Atividade e transferências")
        log_label.set_xalign(0)
        activity_page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        activity_page.append(log_label)
        self.history = Gtk.ListBox()
        history_scroll = Gtk.ScrolledWindow()
        history_scroll.set_min_content_height(110)
        history_scroll.set_child(self.history)
        activity_page.append(history_scroll)
        self.current_history = None
        scroll.set_min_content_height(110)
        activity_page.append(scroll)
        self.progress = Gtk.ProgressBar()
        self.progress.set_show_text(True)
        self.progress.set_text("Aguardando transferência")
        activity_page.append(self.progress)
        self.pages.add_titled(files_page, "files", "Arquivos")
