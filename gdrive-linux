    def append(self, line):
        if is_rate_limit(line):
            line = friendly(line)
        elif any(x in line.lower() for x in ("googleapis.com/google.rpc", "quota_limit_value", "quota_metric", "consumer:", "quota_location:")):
            return False
        buf = self.log.get_buffer()
        buf.insert(buf.get_end_iter(), line + "\n")
        return False

