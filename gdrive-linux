        spinner.start()
        waiting.append(spinner)
        wizard.add_named(waiting, "waiting")
        finished = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        finished.add_css_class("drive-wizard-head")
        result_label = Gtk.Label(label="")
        result_label.set_wrap(True)
        finished.append(result_label)
        wizard.add_named(finished, "finished")
        buttons = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        panel.append(buttons)
        cancel = Gtk.Button(label="Fechar")
        cancel.connect("clicked", lambda *_: dialog.close())
