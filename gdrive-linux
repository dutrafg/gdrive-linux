    def transfer(self, _button, direction, automatic=False):
        if self.busy or self.sync_busy:
            return
        index = self.dropdown.get_selected()
        if index == Gtk.INVALID_LIST_POSITION or index >= self.remotes.get_n_items():
            self.status.set_text("Configure uma conta primeiro.")
            return
        local = str(self.folder)
        try:
            command = copy_command(self.remotes.get_string(index), local, direction, skip_existing=automatic)
        except ValueError as exc:
            self.status.set_text(str(exc))
            return
        self.busy = True
        self.transfer_generation += 1
        generation = self.transfer_generation
        direction_name = "Download" if direction == "download" else "Upload"
        self.current_history = Gtk.Label(label=direction_name + (" automático" if automatic else "") + " • Em andamento")
        self.current_history.set_xalign(0)
        self.history.prepend(self.current_history)
        self.history_empty.set_visible(False)
        self.home_activity.set_text(direction_name + " em andamento…")
        self.proc = None
        self.cancel_requested = False
        self.download.set_sensitive(False)
        self.upload.set_sensitive(False)
        self.cancel_button.set_sensitive(True)
        self.status.set_text("Transferência em andamento…")
        self.progress.set_fraction(0)
        self.progress_known = False
        self.progress.set_text("Transferindo…")
        if not automatic:
            self.navigate("activity")
        self.progress.pulse()
        self.progress_timer = GLib.timeout_add(250, self.pulse_progress)
        threading.Thread(target=self.worker, args=(command, generation), daemon=True).start()

    def pulse_progress(self):
        if not self.busy:
            return False
        if not self.progress_known:
            self.progress.pulse()
        return True

    def worker(self, command, generation):
        result = "Falha ao iniciar transferência."
        proc = None
        quota_detected = False
        try:
            if self.cancel_requested:
                result = "Transferência cancelada."
                return
            proc = subprocess.Popen(
                command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                text=True, bufsize=1)
            self.proc = proc
            if self.cancel_requested:
                proc.terminate()
            for line in proc.stdout:
                if is_rate_limit(line):
                    quota_detected = True
                    continue
                if quota_detected and (line.lstrip().startswith("{") or "quota_" in line.lower() or "googleapis" in line.lower()):
                    continue
                progress = parse_progress(line)
                if progress is not None:
                    GLib.idle_add(self.update_progress, progress, generation)
                else:
                    GLib.idle_add(self.append, line.rstrip())
            code = proc.wait()
            result = ("Transferência cancelada." if self.cancel_requested else
                      "Transferência concluída." if code == 0 else
                      friendly("RATE_LIMIT_EXCEEDED") if quota_detected else
                      "Transferência falhou (código " + str(code) + "). Verifique a conta e o espaço disponível.")
        except OSError as exc:
            result = "Falha na transferência: " + str(exc)
        finally:
            GLib.idle_add(self.finish, generation, result)

    def update_progress(self, data, generation):
        if not self.busy or generation != self.transfer_generation:
            return False
        self.progress_known = True
        self.progress.set_fraction(data["percentage"] / 100)
        detail = str(data["percentage"]) + "% • " + data["transferred"]
        if data["speed"]:
            detail += " • " + data["speed"]
        self.progress.set_text(detail)
        return False

    def finish(self, generation, result):
        if generation != self.transfer_generation:
            return False
        self.proc = None
        self.notice(result, "success" if result == "Transferência concluída." else
                    "warning" if result == "Transferência cancelada." else "error")
        self.home_activity.set_text(result)
        if self.current_history is not None:
            self.current_history.set_text(datetime.now().strftime("%d/%m %H:%M") + " • " + result)
            self.current_history = None
        self.busy = False
        self.progress.set_fraction(1 if result == "Transferência concluída." else 0)
        self.progress.set_text(result)
        self.download.set_sensitive(True)
        self.upload.set_sensitive(True)
        self.cancel_button.set_sensitive(False)
        self.cancel_requested = False
        return False

    def cancel(self, *_):
        self.cancel_requested = True
        if self.proc is not None:
            self.proc.terminate()
        elif self.busy:
            self.status.set_text("Aguardando início da transferência para cancelar…")

class DriveApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="io.github.dutrafg.gdrivelinux")

    def do_activate(self):
        window = self.props.active_window or DriveWindow(self)
        window.present()

def ui_smoke():
    """Check GTK4 navigation and widgets without accessing a Google account."""
    Gtk.init()
    app = DriveApp()
    if not app.register(None):
        raise RuntimeError("GTK4 application registration failed")
    window = DriveWindow(app)
    expected = ("home", "accounts", "files", "sync", "activity", "history",
                "settings", "mount", "photos")
    if not window.has_css_class("drive-window"):
        raise AssertionError("Missing application CSS class")
    for page in expected:
        if page not in window.nav_buttons:
            raise AssertionError("Missing navigation: " + page)
        window.navigate(page)
        if window.pages.get_visible_child_name() != page:
            raise AssertionError("Navigation failed: " + page)
        if not window.nav_buttons[page].has_css_class("drive-selected"):
            raise AssertionError("Active sidebar item missing: " + page)
    if window.folder_label.get_text() != str(window.folder):
        raise AssertionError("Folder labels out of sync")
    if window.auto_enabled:
        raise AssertionError("Automatic download must be opt-in")
    actions = button_flow(Gtk.Button(label="Escolher"),
                          Gtk.Button(label="Abrir"),
                          Gtk.Button(label="Criar pasta"))
    if not isinstance(actions, Gtk.Box):
        raise AssertionError("Responsive action group must be a GTK Box")
    if actions.get_orientation() != Gtk.Orientation.VERTICAL:
        raise AssertionError("Action group must stack vertically")
    if not hasattr(window, "account_identity"):
        raise AssertionError("Account identity status missing")
    if not hasattr(window, "account_connection"):
        raise AssertionError("Account connection status missing")
    if not hasattr(window, "auto_info"):
        raise AssertionError("Automatic-download state label missing")
    if not hasattr(window, "background_status"):
        raise AssertionError("Continuous background service status missing")
    if not hasattr(window, "search_entry"):
        raise AssertionError("Drive search control missing")
    window.close()
    print("GTK4 UI OK: navigation, cards, labels and defaults")
    return 0


if __name__ == "__main__":
    import sys
    if "--ui-smoke" in sys.argv:
        raise SystemExit(ui_smoke())
    raise SystemExit(DriveApp().run())
