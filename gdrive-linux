#!/usr/bin/python3
"""Drive para Linux — GTK4 frontend for rclone."""
import subprocess
import threading
from datetime import datetime
from pathlib import Path
import gi
gi.require_version("Gtk", "4.0")
from gi.repository import Gtk, GLib
from rclone_backend import list_remotes, copy_command, list_files
from settings import load_settings, save_settings
from progress import parse_progress

VERSION = "0.9.0"

class DriveWindow(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Drive para Linux")
        self.set_default_size(860, 620)
        self.proc = None
        self.busy = False
        self.preferences = load_settings()
        self.restoring_accounts = False
        self.cancel_requested = False
        self.progress_known = False
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        root.set_margin_top(20)
        root.set_margin_bottom(20)
        root.set_margin_start(20)
        root.set_margin_end(20)
        self.set_child(root)
        self.pages = Gtk.Stack()
        self.pages.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        nav = Gtk.Box(spacing=8)
        root.append(nav)
        for title, name in (("Arquivos", "files"), ("Atividades", "activity"), ("Contas", "accounts")):
            button = Gtk.Button(label=title)
            button.connect("clicked", lambda _button, page=name: self.pages.set_visible_child_name(page))
            nav.append(button)

        heading = Gtk.Label(label="Drive para Linux")
        heading.set_xalign(0)
        heading.add_css_class("title-1")
        root.append(heading)
        subtitle = Gtk.Label(label="Google Drive com rclone • v" + VERSION)
        subtitle.set_xalign(0)
        root.append(subtitle)

        row = Gtk.Box(spacing=8)
        accounts_page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        accounts_page.append(row)
        row.append(Gtk.Label(label="Conta"))
        self.remotes = Gtk.StringList.new([])
        self.dropdown = Gtk.DropDown(model=self.remotes)
        self.dropdown.set_hexpand(True)
        row.append(self.dropdown)
        refresh = Gtk.Button(label="Atualizar")
        refresh.connect("clicked", self.refresh)
        row.append(refresh)
        config = Gtk.Button(label="Configurar")
        config.connect("clicked", self.configure)
        row.append(config)

        folderrow = Gtk.Box(spacing=8)
        accounts_page.append(folderrow)
        folderrow.append(Gtk.Label(label="Pasta local"))
        self.folder = Path(self.preferences.get("folder", str(Path.home() / "GoogleDrive"))).expanduser()
        self.folder_label = Gtk.Label(label=str(self.folder))
        self.folder_label.set_hexpand(True)
        self.folder_label.set_xalign(0)
        self.folder_label.set_ellipsize(3)
        folderrow.append(self.folder_label)
        choose = Gtk.Button(label="Escolher…")
        choose.connect("clicked", self.choose_folder)
        folderrow.append(choose)

        actions = Gtk.Box(spacing=8)
        accounts_page.append(actions)
        self.download = Gtk.Button(label="Baixar da nuvem")
        self.download.connect("clicked", self.transfer, "download")
        actions.append(self.download)
        self.upload = Gtk.Button(label="Enviar para nuvem")
        self.upload.connect("clicked", self.transfer, "upload")
        actions.append(self.upload)
        self.cancel_button = Gtk.Button(label="Cancelar")
        self.cancel_button.set_sensitive(False)
        self.cancel_button.connect("clicked", self.cancel)
        actions.append(self.cancel_button)

        self.status = Gtk.Label(label="Pronto. Transferências não excluem arquivos automaticamente.")
        self.status.set_xalign(0)
        self.status.set_wrap(True)
        root.append(self.status)
        scroll = Gtk.ScrolledWindow()
        scroll.set_vexpand(True)
        self.log = Gtk.TextView()
        self.log.set_editable(False)
        self.log.set_monospace(True)
        scroll.set_child(self.log)
        self.path_parts = []
        browser_header = Gtk.Box(spacing=8)
        files_page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        files_page.append(browser_header)
        self.back_button = Gtk.Button(label="Voltar")
        self.back_button.connect("clicked", self.go_back)
        self.back_button.set_sensitive(False)
        browser_header.append(self.back_button)
        self.path_label = Gtk.Label(label="Meu Drive")
        self.path_label.set_hexpand(True)
        self.path_label.set_xalign(0)
        browser_header.append(self.path_label)
        reload_button = Gtk.Button(label="Ver arquivos")
        reload_button.connect("clicked", self.browse)
        browser_header.append(reload_button)
        self.files_list = Gtk.ListBox()
        self.files_list.connect("row-activated", self.open_folder)
        file_scroll = Gtk.ScrolledWindow()
        file_scroll.set_min_content_height(140)
        file_scroll.set_child(self.files_list)
        file_scroll.set_vexpand(True)
        files_page.append(file_scroll)
        log_label = Gtk.Label(label="Atividade e transferências")
        log_label.set_xalign(0)
        activity_page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        activity_page.append(log_label)
        self.history = Gtk.ListBox()
        history_scroll = Gtk.ScrolledWindow()
        history_scroll.set_min_content_height(110)
        history_scroll.set_child(self.history)
        activity_page.append(history_scroll)
        self.current_history = None
        scroll.set_min_content_height(110)
        activity_page.append(scroll)
        self.progress = Gtk.ProgressBar()
        self.progress.set_show_text(True)
        self.progress.set_text("Aguardando transferência")
        activity_page.append(self.progress)
        self.pages.add_titled(files_page, "files", "Arquivos")
        self.pages.add_titled(activity_page, "activity", "Atividades")
        self.pages.add_titled(accounts_page, "accounts", "Contas")
        root.append(self.pages)
        self.pages.set_vexpand(True)
        self.pages.set_visible_child_name("files")
        self.browse_generation = 0
        self.dropdown.connect("notify::selected", self.account_changed)
        self.refresh()

    def restore_account(self):
        account = self.preferences.get("account", "")
        for index in range(self.remotes.get_n_items()):
            if self.remotes.get_string(index) == account:
                self.dropdown.set_selected(index)
                break

    def persist(self):
        try:
            save_settings(self.folder, self.selected_remote() or "")
        except OSError as exc:
            self.status.set_text("Não foi possível salvar preferências: " + str(exc))

    def account_changed(self, *_):
        if self.restoring_accounts:
            return
        self.persist()
        self.path_parts = []
        self.browse_generation += 1
        self.path_label.set_text("Meu Drive")
        self.back_button.set_sensitive(False)
        while row := self.files_list.get_row_at_index(0):
            self.files_list.remove(row)

    def selected_remote(self):
        index = self.dropdown.get_selected()
        if index == Gtk.INVALID_LIST_POSITION or index >= self.remotes.get_n_items():
            return None
        return self.remotes.get_string(index)

    def browse(self, *_):
        remote = self.selected_remote()
        if not remote:
            self.status.set_text("Configure uma conta antes de navegar.")
            return
        self.browse_generation += 1
        generation = self.browse_generation
        self.status.set_text("Carregando arquivos…")
        self.path_label.set_text("Meu Drive" + ((" / " + " / ".join(self.path_parts)) if self.path_parts else ""))
        self.back_button.set_sensitive(bool(self.path_parts))
        threading.Thread(target=self.browse_worker, args=(remote, "/".join(self.path_parts), generation), daemon=True).start()

    def browse_worker(self, remote, relative, generation):
        try:
            entries = list_files(remote, relative)
            GLib.idle_add(self.show_files, entries, generation)
        except (OSError, subprocess.SubprocessError, ValueError) as exc:
            GLib.idle_add(self.show_browse_error, str(exc), generation)

    def show_browse_error(self, message, generation):
        if generation == self.browse_generation:
            self.status.set_text("Falha ao listar arquivos: " + message)
        return False

    def show_files(self, entries, generation):
        if generation != self.browse_generation:
            return False
        while row := self.files_list.get_row_at_index(0):
            self.files_list.remove(row)
        for entry in sorted(entries, key=lambda e: (not e["directory"], e["name"].casefold())):
            row = Gtk.ListBoxRow()
            row.entry_name = entry["name"]
            row.is_directory = entry["directory"]
            label = Gtk.Label(label=("📁 " if entry["directory"] else "📄 ") + entry["name"])
            label.set_xalign(0)
            label.set_margin_top(6)
            label.set_margin_bottom(6)
            label.set_margin_start(8)
            row.set_child(label)
            self.files_list.append(row)
        self.status.set_text(f"{len(entries)} itens encontrados.")
        return False

    def open_folder(self, _listbox, row):
        if row.is_directory:
            self.path_parts.append(row.entry_name)
            self.browse()

    def go_back(self, *_):
        if self.path_parts:
            self.path_parts.pop()
        self.browse()

    def choose_folder(self, *_):
        dialog = Gtk.FileChooserNative(title="Escolher pasta local", transient_for=self,
                                      action=Gtk.FileChooserAction.SELECT_FOLDER,
                                      accept_label="Selecionar", cancel_label="Cancelar")
        def response(d, code):
            if code == Gtk.ResponseType.ACCEPT:
                file = d.get_file()
                if file and file.get_path():
                    self.folder = Path(file.get_path())
                    self.folder_label.set_text(str(self.folder))
                    self.persist()
            d.destroy()
        dialog.connect("response", response)
        dialog.show()

    def configure(self, *_):
        try:
            subprocess.Popen(["x-terminal-emulator", "-e", "rclone", "config"])
            self.status.set_text("Configure a conta no terminal e clique em Atualizar.")
        except OSError:
            self.status.set_text("Abra um terminal e execute: rclone config")

    def refresh(self, *_):
        try:
            names = list_remotes()
            current = self.selected_remote() or self.preferences.get("account", "")
            self.restoring_accounts = True
            self.remotes.splice(0, self.remotes.get_n_items(), names)
            self.path_parts = []
            self.browse_generation += 1
            if names:
                self.dropdown.set_selected(names.index(current) if current in names else 0)
            self.restoring_accounts = False
            self.account_changed()
            if not names:
                self.status.set_text("Nenhuma conta configurada. Clique em Configurar.")
        except (OSError, subprocess.SubprocessError) as exc:
            self.status.set_text("Não foi possível consultar o rclone: " + str(exc))

    def append(self, line):
        buf = self.log.get_buffer()
        buf.insert(buf.get_end_iter(), line + "\n")
        return False

    def transfer(self, _button, direction):
        if self.busy:
            return
        index = self.dropdown.get_selected()
        if index == Gtk.INVALID_LIST_POSITION or index >= self.remotes.get_n_items():
            self.status.set_text("Configure uma conta primeiro.")
            return
        local = str(self.folder)
        try:
            command = copy_command(self.remotes.get_string(index), local, direction)
        except ValueError as exc:
            self.status.set_text(str(exc))
            return
        self.busy = True
        direction_name = "Download" if direction == "download" else "Upload"
        self.current_history = Gtk.Label(label=direction_name + " • Em andamento")
        self.current_history.set_xalign(0)
        self.history.prepend(self.current_history)
        self.proc = None
        self.cancel_requested = False
        self.download.set_sensitive(False)
        self.upload.set_sensitive(False)
        self.cancel_button.set_sensitive(True)
        self.status.set_text("Transferência em andamento…")
        self.progress.set_fraction(0)
        self.progress_known = False
        self.progress.set_text("Transferindo…")
        self.pages.set_visible_child_name("activity")
        self.progress.pulse()
        self.progress_timer = GLib.timeout_add(250, self.pulse_progress)
        threading.Thread(target=self.worker, args=(command,), daemon=True).start()

    def pulse_progress(self):
        if not self.busy:
            return False
        if not self.progress_known:
            self.progress.pulse()
        return True

    def worker(self, command):
        try:
            if self.cancel_requested:
                GLib.idle_add(self.status.set_text, "Transferência cancelada.")
                return
            proc = subprocess.Popen(
                command,
                stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)
            self.proc = proc
            if self.cancel_requested:
                proc.terminate()
            for line in proc.stdout:
                progress = parse_progress(line)
                if progress is not None:
                    GLib.idle_add(self.update_progress, progress)
                else:
                    GLib.idle_add(self.append, line.rstrip())
            code = proc.wait()
            GLib.idle_add(self.status.set_text,
                          "Transferência cancelada." if self.cancel_requested else
                          ("Transferência concluída." if code == 0 else f"Transferência encerrada (código {code})."))
        except OSError as exc:
            GLib.idle_add(self.status.set_text, str(exc))
        finally:
            self.proc = None
            GLib.idle_add(self.finish)

    def update_progress(self, data):
        if not self.busy:
            return False
        self.progress_known = True
        self.progress.set_fraction(data["percentage"] / 100)
        detail = str(data["percentage"]) + "% • " + data["transferred"]
        if data["speed"]:
            detail += " • " + data["speed"]
        self.progress.set_text(detail)
        return False

    def finish(self):
        if self.current_history is not None:
            self.current_history.set_text(datetime.now().strftime("%d/%m %H:%M") + " • " + self.status.get_text())
            self.current_history = None
        self.busy = False
        self.progress.set_fraction(0)
        self.progress.set_text(self.status.get_text())
        self.download.set_sensitive(True)
        self.upload.set_sensitive(True)
        self.cancel_button.set_sensitive(False)
        self.cancel_requested = False
        return False

    def cancel(self, *_):
        self.cancel_requested = True
        if self.proc is not None:
            self.proc.terminate()
        elif self.busy:
            self.status.set_text("Aguardando início da transferência para cancelar…")

class DriveApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="io.github.dutrafg.gdrivelinux")

    def do_activate(self):
        window = self.props.active_window or DriveWindow(self)
        window.present()

if __name__ == "__main__":
    raise SystemExit(DriveApp().run())
