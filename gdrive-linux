                         args=(target,), daemon=True).start()

    def mount_status_worker(self, target):
        # systemd may be active before the FUSE mount is ready; never imply
        # mounted = true from the service state alone.
        message = mount_diagnosis(target)
        GLib.idle_add(self.mount_status.set_text, message)
        return False

    def start_mount(self, *_):
        if self.mount_busy:
            return
        remote = self.selected_remote()
        if not remote:
            self.notice("Selecione uma conta Google Drive.", "warning")
            return
        config = dict(self.preferences)
        config.update({"account": remote, "folder": str(self.folder),
                       "mount_read_only": self.mount_read_only})
        try:
            mount_command(config, require_tools=True, create=False)
        except (ValueError, RuntimeError, OSError) as exc:
            self.notice(str(exc), "error")
            return
        self.mount_busy = True
        self.persist()
        self.mount_status.set_text("Preparando FUSE e aguardando confirmação do rclone. Isso pode levar até 2 minutos…")
        threading.Thread(target=self.mount_action_worker, args=("start", remote),
                         daemon=True).start()

