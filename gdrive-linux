        self.refresh_generation = 0
        self.cancel_requested = False
        self.progress_known = False
        self.transfer_generation = 0
        self.sync_busy = False
        self.auto_enabled = False
        self.auto_generation = 0
        self.auto_interval_seconds = 300
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        root.set_margin_top(20)
        root.set_margin_bottom(20)
        root.set_margin_start(20)
        root.set_margin_end(20)
        self.set_child(root)
        self.pages = Gtk.Stack()
        self.pages.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        nav = Gtk.Box(spacing=8)
        root.append(nav)
        for title, name in (("Arquivos", "files"), ("Atividades", "activity"), ("Contas", "accounts")):
            button = Gtk.Button(label=title)
            button.connect("clicked", lambda _button, page=name: self.pages.set_visible_child_name(page))
            nav.append(button)

        heading = Gtk.Label(label="Drive para Linux")
        heading.set_xalign(0)
        heading.add_css_class("title-1")
        root.append(heading)
        subtitle = Gtk.Label(label="Google Drive com rclone • v" + VERSION)
        subtitle.set_xalign(0)
        root.append(subtitle)

        row = Gtk.Box(spacing=8)
        accounts_page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        accounts_page.append(row)
        row.append(Gtk.Label(label="Conta"))
        self.remotes = Gtk.StringList.new([])
        self.dropdown = Gtk.DropDown(model=self.remotes)
        self.dropdown.set_hexpand(True)
        row.append(self.dropdown)
        refresh = Gtk.Button(label="Atualizar")
        refresh.connect("clicked", self.refresh)
        row.append(refresh)
        config = Gtk.Button(label="Configurar")
        config.connect("clicked", self.configure)
        row.append(config)
        connect_google = Gtk.Button(label="Conectar Google")
        connect_google.connect("clicked", self.connect_google)
        accounts_page.append(connect_google)

        folderrow = Gtk.Box(spacing=8)
        accounts_page.append(folderrow)
        folderrow.append(Gtk.Label(label="Pasta local"))
        self.folder = Path(self.preferences.get("folder", str(Path.home() / "GoogleDrive"))).expanduser()
        self.folder_label = Gtk.Label(label=str(self.folder))
        self.folder_label.set_hexpand(True)
        self.folder_label.set_xalign(0)
        self.folder_label.set_ellipsize(3)
        folderrow.append(self.folder_label)
        choose = Gtk.Button(label="Escolher…")
        choose.connect("clicked", self.choose_folder)
        folderrow.append(choose)
        open_folder = Gtk.Button(label="Abrir no gerenciador")
        open_folder.connect("clicked", self.open_local_folder)
        accounts_page.append(open_folder)
        auto_row = Gtk.Box(spacing=8)
        accounts_page.append(auto_row)
        self.auto_switch = Gtk.Switch()
        self.auto_switch.connect("notify::active", self.auto_changed)
        auto_row.append(Gtk.Label(label="Atualizar da nuvem automaticamente (5 min)"))
        auto_row.append(self.auto_switch)
        note = Gtk.Label(label="Somente download; arquivos locais existentes não serão sobrescritos.")
        note.set_wrap(True)
        note.set_xalign(0)
        accounts_page.append(note)
        preview = Gtk.Button(label="Simular sincronização bidirecional")
        preview.connect("clicked", self.preview_sync)
        accounts_page.append(preview)
        safe_button = Gtk.Button(label="Transferir somente arquivos novos (sem sobrescrever)")
        safe_button.connect("clicked", self.safe_sync)
        accounts_page.append(safe_button)

        actions = Gtk.Box(spacing=8)
        accounts_page.append(actions)
        self.download = Gtk.Button(label="Baixar da nuvem")
        self.download.connect("clicked", self.transfer, "download")
        actions.append(self.download)
        self.upload = Gtk.Button(label="Enviar para nuvem")
        self.upload.connect("clicked", self.transfer, "upload")
        actions.append(self.upload)
        self.cancel_button = Gtk.Button(label="Cancelar")
        self.cancel_button.set_sensitive(False)
        self.cancel_button.connect("clicked", self.cancel)
        actions.append(self.cancel_button)

        self.status = Gtk.Label(label="Pronto. Transferências não excluem arquivos automaticamente.")
        self.status.set_xalign(0)
        self.status.set_wrap(True)
