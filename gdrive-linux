    def navigate(self, page):
        pages = {
            "home": ("Início", "Seu Google Drive, organizado e protegido."),
            "accounts": ("Contas", "Conexão Google e pastas locais."),
            "files": ("Arquivos", "Navegue pelos documentos no Google Drive."),
            "sync": ("Sincronização", "Compare e transfira arquivos novos com segurança."),
            "activity": ("Transferências", "Acompanhe o progresso e os registros do rclone."),
            "mount": ("Disco virtual", "Abra seu Drive diretamente no gerenciador de arquivos."),
            "photos": ("Google Fotos", "Envio opcional de fotos e vídeos para um álbum."),
            "history": ("Histórico", "Operações desta sessão do aplicativo."),
            "settings": ("Configurações", "Preferências, automação e diagnóstico."),
        }
        if page not in pages:
            return
        self.pages.set_visible_child_name(page)
        self.header_title.set_text(pages[page][0])
        self.header_subtitle.set_text(pages[page][1])
        for key, button in self.nav_buttons.items():
            button.remove_css_class("drive-selected")
            if key == page:
                button.add_css_class("drive-selected")
        if not self.busy and not self.sync_busy:
            if page == "sync":
                self.notice("Sincronização contínua agendada; consulte o serviço." if self.auto_enabled else "Sincronização pausada. Use Simular para consultar diferenças.")
            elif page == "files":
                self.notice("Navegação consulta arquivos; só os botões de transferência copiam dados.")

    def make_columns(self, *cards):
        """One responsive FlowBox row with child widgets that report true height.

        Card action groups are Gtk.Box (not nested FlowBox) to prevent controls
        from protruding into the next section on Zorin/GNOME.
        """
        grid = Gtk.FlowBox()
        grid.set_min_children_per_line(1)
        grid.set_max_children_per_line(2)
        grid.set_column_spacing(14)
        grid.set_row_spacing(14)
        grid.set_homogeneous(False)
        grid.set_selection_mode(Gtk.SelectionMode.NONE)
        for child in cards:
            child.set_size_request(230, -1)
            child.set_hexpand(True)
            grid.insert(child, -1)
        return grid

