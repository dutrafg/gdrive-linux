    def google_auth_worker(self, command, dialog, wizard, result_label, show_step, action, name, optional):
        """Do not capture or display OAuth token-bearing rclone output."""
        try:
            if command[3] in list_remotes():
                message = "Essa conta já existe. Feche a janela e escolha outro nome."
                success = False
            else:
                result = subprocess.run(command, stdout=subprocess.DEVNULL,
                                        stderr=subprocess.DEVNULL, timeout=300)
                created = result.returncode == 0 and command[3] in list_remotes()
                if created:
                    GLib.idle_add(show_step, 2)
                    success = verify_google_remote(command[3])
                else:
                    success = False
                message = ("Conta conectada e acesso confirmado!" if success else
                           "Conta cadastrada, mas sem acesso confirmado. Confira o navegador e as credenciais."
                           if created else
                           "Não foi possível concluir o OAuth. Confira a configuração do Google e tente novamente.")
        except subprocess.TimeoutExpired:
            success, message = False, "Tempo de autorização ou verificação esgotado. Tente novamente."
        except (OSError, subprocess.SubprocessError):
            success, message = False, "O rclone não iniciou. Verifique se está instalado."
        GLib.idle_add(self.complete_google_auth, dialog, wizard, result_label,
                      show_step, action, name, optional, success, message)

    def complete_google_auth(self, dialog, wizard, label, show_step, action, name, optional, success, message):
        if not dialog.get_visible():
            return False
        wizard.set_visible_child_name("finished")
        show_step(3 if success else 2)
        label.set_text(message)
        self.notice(message, "success" if success else "error")
        if success:
            action.set_visible(False)
            self.navigate("accounts")
            self.refresh()
        else:
            name.set_sensitive(True)
            optional.set_sensitive(True)
            action.set_label("Tentar novamente")
            action.set_sensitive(True)
        return False

