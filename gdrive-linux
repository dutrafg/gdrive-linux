    def auto_changed(self, switch, *_):
        if self.restoring_auto:
            return
        requested = switch.get_active()
        if requested and not self.sync_profiles and (not self.selected_remote() or not self.folder.is_dir()):
            self.notice("Selecione uma conta e uma pasta existente antes de ativar.", "warning")
            self.restoring_auto = True
            switch.set_active(False)
            self.restoring_auto = False
            return
        self.auto_enabled = requested
        self.persist()
        self.auto_info.set_text("Configurando sincronização no Linux…")
        threading.Thread(target=self.background_toggle_worker,
                         args=(requested,), daemon=True).start()

    def background_toggle_worker(self, requested):
        success = False
        try:
            refresh = subprocess.run(["systemctl", "--user", "daemon-reload"],
                                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                     timeout=20)
            if refresh.returncode:
                raise RuntimeError("systemd do usuário indisponível")
            option = "enable" if requested else "disable"
            response = subprocess.run(["systemctl", "--user", option, "--now",
                                        "gdrive-linux-sync.timer"],
                                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                       timeout=30)
            if response.returncode:
                raise RuntimeError("Não foi possível configurar a sincronização automática")
            if requested:
                subprocess.run(["systemctl", "--user", "--no-block", "start",
                                "gdrive-linux-sync.service"],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                               timeout=10)
            success = True
            message = ("Sincronização contínua ativada; primeira verificação solicitada ao Linux."
                       if requested else "Sincronização contínua desativada.")
        except (OSError, RuntimeError, subprocess.SubprocessError) as exc:
            message = str(exc)
        GLib.idle_add(self.background_toggle_complete, requested, success, message)

    def background_toggle_complete(self, requested, success, message):
        if self.auto_switch.get_active() != requested:
            return False
        if requested and not success:
            self.auto_enabled = False
            self.restoring_auto = True
            self.auto_switch.set_active(False)
            self.restoring_auto = False
            self.persist()
        self.auto_info.set_text(message)
        self.notice(message, "success" if success else "warning")
        self.update_background_status()
        return False

    def check_timer_worker(self):
        try:
            result = subprocess.run(
                ["systemctl", "--user", "is-active", "gdrive-linux-sync.timer"],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=8)
            if result.returncode:
                GLib.idle_add(self.background_status.set_text,
                    "Sincronização marcada nas preferências, mas o timer Linux "
                    "não está ativo. Desative e ative novamente para corrigir.")
        except (OSError, subprocess.SubprocessError):
            GLib.idle_add(self.background_status.set_text,
                "Não foi possível consultar o timer do Linux; verifique systemd --user.")

    def run_background_now(self, *_):
        if not self.auto_enabled:
            self.notice("Ative a sincronização contínua para sincronizar agora.", "warning")
            return
        self.auto_info.set_text("Solicitando sincronização pelo serviço do Linux…")
        threading.Thread(target=self.run_background_now_worker, daemon=True).start()

    def run_background_now_worker(self):
        try:
            response = subprocess.run(
                ["systemctl", "--user", "start", "gdrive-linux-sync.service"],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=1100)
            success = response.returncode == 0
        except (OSError, subprocess.SubprocessError):
            success = False
        GLib.idle_add(self.finish_background_now, success)

    def finish_background_now(self, success):
        self.update_background_status()
        self.notice("Verificação de sincronização concluída."
                    if success else "O serviço não concluiu a sincronização. Verifique o status.",
                    "success" if success else "warning")
        return False

    def update_background_status(self, *_):
        status = read_json(STATE_BASE / "latest.json")
        state = status.get("state")
        if not self.auto_enabled:
            message = "Pausada. Nenhum ciclo automático programado."
        elif state == "ok":
            message = (str(status.get("copied", 0)) + " arquivo(s) transferido(s), " +
                       str(status.get("pending", 0)) + " pendente(s), " +
                       str(status.get("archived", 0)) + " arquivado(s). " +
                       str(status.get("time", "")))
        elif state == "conflicts":
            message = (str(status.get("conflicts", 0)) +
                       " conflito(s) pendente(s). " + str(status.get("time", "")))
        elif state == "quota":
            message = ("Google Drive bloqueou chamadas da API (403). " +
                       "Próxima tentativa após: " + str(status.get("retry_after", "?")) +
                       ". Configure Client ID próprio no rclone.")
        elif state == "error":
            message = "A última verificação falhou. Revise a conexão e a pasta."
        else:
            message = "Agendada; aguardando o primeiro ciclo do systemd."
        self.background_status.set_text(message)
        if self.auto_enabled:
            threading.Thread(target=self.check_timer_worker, daemon=True).start()
        return False

