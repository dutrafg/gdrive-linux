    def restore_account(self):
        account = self.preferences.get("account", "")
        for index in range(self.remotes.get_n_items()):
            if self.remotes.get_string(index) == account:
                self.dropdown.set_selected(index)
                break

    def persist(self):
        try:
            account = self.selected_remote() or ""
            save_settings(self.folder, account)
            self.preferences["account"] = account
            self.preferences["folder"] = str(self.folder)
        except OSError as exc:
            self.status.set_text("Não foi possível salvar preferências: " + str(exc))

    def account_changed(self, *_):
        if self.restoring_accounts:
            return
        self.persist()
        self.path_parts = []
        self.browse_generation += 1
        self.path_label.set_text("Meu Drive")
        self.back_button.set_sensitive(False)
        while row := self.files_list.get_row_at_index(0):
            self.files_list.remove(row)

    def selected_remote(self):
        index = self.dropdown.get_selected()
        if index == Gtk.INVALID_LIST_POSITION or index >= self.remotes.get_n_items():
            return None
        return self.remotes.get_string(index)

    def browse(self, *_):
        remote = self.selected_remote()
        if not remote:
            self.status.set_text("Configure uma conta antes de navegar.")
            return
        self.browse_generation += 1
        generation = self.browse_generation
        self.status.set_text("Carregando arquivos…")
        self.path_label.set_text("Meu Drive" + ((" / " + " / ".join(self.path_parts)) if self.path_parts else ""))
        self.back_button.set_sensitive(bool(self.path_parts))
        threading.Thread(target=self.browse_worker, args=(remote, "/".join(self.path_parts), generation), daemon=True).start()

    def browse_worker(self, remote, relative, generation):
        try:
            entries = list_files(remote, relative)
            GLib.idle_add(self.show_files, entries, generation)
        except (OSError, subprocess.SubprocessError, ValueError) as exc:
            GLib.idle_add(self.show_browse_error, str(exc), generation)

    def show_browse_error(self, message, generation):
        if generation == self.browse_generation:
            self.status.set_text("Falha ao listar arquivos: " + message)
        return False

    def show_files(self, entries, generation):
        if generation != self.browse_generation:
            return False
        while row := self.files_list.get_row_at_index(0):
            self.files_list.remove(row)
        for entry in sorted(entries, key=lambda e: (not e["directory"], e["name"].casefold())):
            row = Gtk.ListBoxRow()
            row.entry_name = entry["name"]
            row.is_directory = entry["directory"]
            label = Gtk.Label(label=("📁 " if entry["directory"] else "📄 ") + entry["name"])
            label.set_xalign(0)
            label.set_margin_top(6)
            label.set_margin_bottom(6)
            label.set_margin_start(8)
            row.set_child(label)
            self.files_list.append(row)
        self.status.set_text(f"{len(entries)} itens encontrados.")
        return False

    def open_folder(self, _listbox, row):
        if row.is_directory:
            self.path_parts.append(row.entry_name)
            self.browse()

    def go_back(self, *_):
        if self.path_parts:
            self.path_parts.pop()
        self.browse()

    def choose_folder(self, *_):
        dialog = Gtk.FileChooserNative(title="Escolher pasta local", transient_for=self,
                                      action=Gtk.FileChooserAction.SELECT_FOLDER,
                                      accept_label="Selecionar", cancel_label="Cancelar")
        def response(d, code):
            if code == Gtk.ResponseType.ACCEPT:
                file = d.get_file()
                if file and file.get_path():
                    self.folder = Path(file.get_path())
                    self.folder_label.set_text(str(self.folder))
                    self.persist()
            d.destroy()
        dialog.connect("response", response)
        dialog.show()

    def safe_sync(self, *_):
        if self.busy or self.sync_busy:
            self.status.set_text("Aguarde a operação atual.")
            return
        remote = self.selected_remote()
        if not remote or not self.folder.is_dir():
            self.status.set_text("Selecione uma conta e pasta local existente.")
            return
        self.sync_busy = True
        self.status.set_text("Transferindo somente arquivos novos (máximo 100)…")
        threading.Thread(target=self.safe_sync_worker,
                         args=(remote, self.folder), daemon=True).start()

    def safe_sync_worker(self, remote, folder):
        try:
            plan, completed = execute_additions(remote, folder, dry_run=False)
            message = (str(completed) + " arquivos novos transferidos; " +
                       str(len(plan.conflicts)) + " conflitos preservados.")
        except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as exc:
            message = "Sincronização seletiva interrompida: " + str(exc)
        GLib.idle_add(self.finish_safe_sync, message)

    def finish_safe_sync(self, message):
        self.sync_busy = False
        self.status.set_text(message)
        self.append(message)
        return False

    def preview_sync(self, *_):
        remote = self.selected_remote()
        if not remote or not self.folder.is_dir():
            self.status.set_text("Selecione uma conta e pasta local existente.")
            return
        self.status.set_text("Comparando arquivos sem transferir ou excluir nada…")
        threading.Thread(target=self.preview_sync_worker,
                         args=(remote, self.folder), daemon=True).start()

    def preview_sync_worker(self, remote, folder):
        try:
            local = local_inventory(folder)
            cloud = remote_inventory(remote)
            plan = conservative_plan(local, cloud)
            message = ("Simulação: " + str(len(plan.download)) + " para baixar, " +
                       str(len(plan.upload)) + " para enviar, " +
                       str(len(plan.conflicts)) + " conflitos. Nenhuma alteração feita.")
            GLib.idle_add(self.status.set_text, message)
            GLib.idle_add(self.append, message)
            for name in plan.conflicts[:30]:
                GLib.idle_add(self.append, "Conflito (sem alterações): " + name)
        except (OSError, ValueError, subprocess.SubprocessError) as exc:
            GLib.idle_add(self.status.set_text, "Simulação falhou: " + str(exc))

    def open_local_folder(self, *_):
        try:
            if not self.folder.is_dir():
                self.status.set_text("Escolha uma pasta local existente.")
                return
            Gio.AppInfo.launch_default_for_uri(self.folder.resolve().as_uri(), None)
        except (GLib.Error, OSError) as exc:
            self.status.set_text("Falha ao abrir pasta: " + str(exc))

    def auto_changed(self, switch, *_):
        self.auto_enabled = switch.get_active()
        self.auto_generation += 1
        generation = self.auto_generation
        if self.auto_enabled:
            self.status.set_text("Atualização automática ativa nesta sessão.")
            GLib.timeout_add_seconds(self.auto_interval_seconds, self.auto_tick, generation)
        else:
            self.status.set_text("Atualização automática desativada.")

    def auto_tick(self, generation):
        if not self.auto_enabled or generation != self.auto_generation:
            return False
        if not self.busy and not self.sync_busy and self.selected_remote() and self.folder.is_dir():
            self.transfer(None, "download", automatic=True)
        return True

    def connect_google(self, *_):
        dialog = Gtk.Window(title="Conectar Google Drive", transient_for=self, modal=True)
        dialog.set_default_size(440, 240)
        panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        panel.set_margin_top(18)
        panel.set_margin_bottom(18)
        panel.set_margin_start(18)
        panel.set_margin_end(18)
        dialog.set_child(panel)
        info = Gtk.Label(label="Crie um cliente OAuth do tipo Desktop no Google Cloud. A autorização será aberta pelo rclone no navegador.")
        info.set_wrap(True)
        panel.append(info)
        name = Gtk.Entry()
        name.set_placeholder_text("Nome da conta (ex.: meu_drive)")
        panel.append(name)
        client = Gtk.Entry()
        client.set_placeholder_text("Client ID (*.apps.googleusercontent.com)")
        panel.append(client)
        action = Gtk.Button(label="Autorizar no navegador")
        panel.append(action)
        def start(_button):
            try:
                command = google_config_command(name.get_text().strip(), client.get_text().strip())
            except ValueError as exc:
                info.set_text(str(exc))
                return
            dialog.close()
            self.status.set_text("Aguardando autorização Google no navegador…")
            threading.Thread(target=self.google_auth_worker, args=(command,), daemon=True).start()
        action.connect("clicked", start)
        dialog.present()

    def google_auth_worker(self, command):
        try:
            # Prevent overwriting an existing rclone remote and its OAuth tokens.
            if command[3] in list_remotes():
                GLib.idle_add(self.status.set_text, "Essa conta já existe no rclone. Escolha outro nome.")
                return
            result = subprocess.run(command, stdout=subprocess.DEVNULL,
                                    stderr=subprocess.DEVNULL, timeout=240)
            if result.returncode:
                GLib.idle_add(self.status.set_text, "Autorização não concluída. Confira o navegador e a configuração OAuth.")
            else:
                GLib.idle_add(self.refresh)
                GLib.idle_add(self.status.set_text, "Conta criada. Selecione-a em Contas.")
        except subprocess.TimeoutExpired:
            GLib.idle_add(self.status.set_text, "Tempo limite de autorização atingido.")
        except (OSError, subprocess.SubprocessError) as exc:
            GLib.idle_add(self.status.set_text, "Falha ao iniciar autorização pelo rclone.")

    def configure(self, *_):
        try:
            subprocess.Popen(["x-terminal-emulator", "-e", "rclone", "config"])
            self.status.set_text("Configure a conta no terminal e clique em Atualizar.")
        except OSError:
            self.status.set_text("Abra um terminal e execute: rclone config")

    def refresh(self, *_):
        """Fetch rclone remotes off the GTK main thread."""
        self.refresh_generation += 1
        generation = self.refresh_generation
        self.status.set_text("Consultando contas…")
        threading.Thread(target=self.refresh_worker, args=(generation,), daemon=True).start()

    def refresh_worker(self, generation):
        try:
            names = list_remotes()
        except (OSError, subprocess.SubprocessError) as exc:
            GLib.idle_add(self.refresh_error, generation, str(exc))
            return
        GLib.idle_add(self.refresh_complete, generation, names)

    def refresh_error(self, generation, message):
        if generation == self.refresh_generation:
            self.status.set_text("Não foi possível consultar o rclone: " + message)
        return False

    def refresh_complete(self, generation, names):
        if generation != self.refresh_generation:
            return False
        current = self.selected_remote() or self.preferences.get("account", "")
        self.restoring_accounts = True
        try:
            self.remotes.splice(0, self.remotes.get_n_items(), names)
            self.dropdown.set_selected(names.index(current) if current in names else (0 if names else Gtk.INVALID_LIST_POSITION))
        finally:
            self.restoring_accounts = False
        self.account_changed()
        self.status.set_text(
            str(len(names)) + " conta(s) disponível(is)." if names
            else "Nenhuma conta configurada. Clique em Configurar."
        )
        return False

    def append(self, line):
        buf = self.log.get_buffer()
        buf.insert(buf.get_end_iter(), line + "\n")
        return False

    def transfer(self, _button, direction, automatic=False):
        if self.busy or self.sync_busy:
            return
        index = self.dropdown.get_selected()
        if index == Gtk.INVALID_LIST_POSITION or index >= self.remotes.get_n_items():
            self.status.set_text("Configure uma conta primeiro.")
            return
        local = str(self.folder)
        try:
            command = copy_command(self.remotes.get_string(index), local, direction, skip_existing=automatic)
        except ValueError as exc:
            self.status.set_text(str(exc))
            return
        self.busy = True
        self.transfer_generation += 1
        generation = self.transfer_generation
        direction_name = "Download" if direction == "download" else "Upload"
        self.current_history = Gtk.Label(label=direction_name + (" automático" if automatic else "") + " • Em andamento")
        self.current_history.set_xalign(0)
        self.history.prepend(self.current_history)
        self.proc = None
        self.cancel_requested = False
        self.download.set_sensitive(False)
        self.upload.set_sensitive(False)
        self.cancel_button.set_sensitive(True)
        self.status.set_text("Transferência em andamento…")
        self.progress.set_fraction(0)
        self.progress_known = False
        self.progress.set_text("Transferindo…")
        if not automatic:
            self.pages.set_visible_child_name("activity")
        self.progress.pulse()
        self.progress_timer = GLib.timeout_add(250, self.pulse_progress)
        threading.Thread(target=self.worker, args=(command, generation), daemon=True).start()

    def pulse_progress(self):
        if not self.busy:
            return False
        if not self.progress_known:
            self.progress.pulse()
        return True

    def worker(self, command, generation):
        result = "Falha ao iniciar transferência."
        proc = None
        try:
            if self.cancel_requested:
                result = "Transferência cancelada."
                return
            proc = subprocess.Popen(
                command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                text=True, bufsize=1)
            self.proc = proc
            if self.cancel_requested:
                proc.terminate()
            for line in proc.stdout:
                progress = parse_progress(line)
                if progress is not None:
                    GLib.idle_add(self.update_progress, progress, generation)
                else:
                    GLib.idle_add(self.append, line.rstrip())
            code = proc.wait()
            result = ("Transferência cancelada." if self.cancel_requested else
                      "Transferência concluída." if code == 0 else
                      "Transferência falhou (código " + str(code) + ").")
        except OSError as exc:
            result = "Falha na transferência: " + str(exc)
        finally:
            GLib.idle_add(self.finish, generation, result)

    def update_progress(self, data, generation):
        if not self.busy or generation != self.transfer_generation:
            return False
        self.progress_known = True
        self.progress.set_fraction(data["percentage"] / 100)
        detail = str(data["percentage"]) + "% • " + data["transferred"]
        if data["speed"]:
            detail += " • " + data["speed"]
        self.progress.set_text(detail)
        return False

    def finish(self, generation, result):
        if generation != self.transfer_generation:
            return False
        self.proc = None
        self.status.set_text(result)
        if self.current_history is not None:
            self.current_history.set_text(datetime.now().strftime("%d/%m %H:%M") + " • " + result)
            self.current_history = None
        self.busy = False
        self.progress.set_fraction(1 if result == "Transferência concluída." else 0)
        self.progress.set_text(result)
        self.download.set_sensitive(True)
        self.upload.set_sensitive(True)
        self.cancel_button.set_sensitive(False)
        self.cancel_requested = False
        return False

    def cancel(self, *_):
        self.cancel_requested = True
        if self.proc is not None:
            self.proc.terminate()
        elif self.busy:
            self.status.set_text("Aguardando início da transferência para cancelar…")

class DriveApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="io.github.dutrafg.gdrivelinux")

    def do_activate(self):
        window = self.props.active_window or DriveWindow(self)
        window.present()

if __name__ == "__main__":
    raise SystemExit(DriveApp().run())
