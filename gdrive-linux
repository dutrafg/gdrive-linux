    def notice(self, message, tone=None):
        self.status.set_text(message)
        for css in ("drive-status-success", "drive-status-error", "drive-status-warning"):
            self.status.remove_css_class(css)
        if tone in ("success", "error", "warning"):
            self.status.add_css_class("drive-status-" + tone)

    def restore_account(self):
        account = self.preferences.get("account", "")
        for index in range(self.remotes.get_n_items()):
            if self.remotes.get_string(index) == account:
                self.dropdown.set_selected(index)
                break

    def persist(self):
        try:
            account = self.selected_remote() or ""
            save_settings(self.folder, account, self.account_names,
                          self.auto_enabled, self.mount_read_only)
            self.preferences["account"] = account
            self.preferences["folder"] = str(self.folder)
        except OSError as exc:
            self.status.set_text("Não foi possível salvar preferências: " + str(exc))

    def account_changed(self, *_):
        if self.restoring_accounts:
            return
        previous = self.preferences.get("account", "")
        requested = self.selected_remote()
        if self.auto_enabled and previous and requested != previous:
            self.restoring_accounts = True
            try:
                names = [self.remotes.get_string(i) for i in
                         range(self.remotes.get_n_items())]
                if previous in names:
                    self.dropdown.set_selected(names.index(previous))
            finally:
                self.restoring_accounts = False
            self.notice("Pause a sincronização contínua antes de trocar a conta.", "warning")
            return
        self.persist()
        self.verify_generation += 1
        remote = self.selected_remote()
        self.account_identity.set_text(
            ("Conta selecionada: " + self.account_display(remote))
            if remote else "Nenhuma conta selecionada")
        self.account_name_entry.set_text(self.account_names.get(remote, "") if remote else "")
        self.account_name_entry.set_sensitive(bool(remote))
        self.account_connection.set_text(
            "Conta configurada no rclone • acesso ainda não verificado"
            if remote else "Nenhuma conta configurada ou selecionada.")
        self.verify_button.set_sensitive(bool(remote))
        self.sidebar_account.set_text(
            "Conta: " + self.account_display(remote)
            if remote else "Conta: nenhuma selecionada")
        self.home_accounts.set_text(self.account_display(remote)
                                    if remote else "Nenhuma conta conectada")
        self.path_parts = []
        self.browse_generation += 1
        self.preview_generation += 1
        self.sync_report.set_text("Selecione Simular para comparar esta conta.")
        self.path_label.set_text("Meu Drive")
        self.back_button.set_sensitive(False)
        self.files_summary.set_text("Clique em Atualizar para listar os arquivos.")
        while row := self.files_list.get_row_at_index(0):
            self.files_list.remove(row)

    def account_display(self, remote):
        """Show a user-supplied label plus the actual configured rclone remote."""
        if not remote:
            return "Nenhuma conta"
        nickname = self.account_names.get(remote, "").strip()
        return (nickname + " (" + remote + ")") if nickname else remote

    def save_account_name(self, *_):
        remote = self.selected_remote()
        if not remote:
            self.notice("Selecione uma conta antes de salvar a identificação.", "warning")
            return
        value = self.account_name_entry.get_text().strip()
        if len(value) > 120:
            self.notice("Identificação muito longa (máximo 120 caracteres).", "warning")
            return
        if value:
            self.account_names[remote] = value
        else:
            self.account_names.pop(remote, None)
        self.persist()
        self.account_identity.set_text("Conta selecionada: " + self.account_display(remote))
        self.sidebar_account.set_text("Conta: " + self.account_display(remote))
        self.home_accounts.set_text(self.account_display(remote))
        self.notice("Identificação local salva. Isso não verifica o e-mail Google.", "success")

    def verify_selected_account(self, *_):
        """Verify the selected rclone remote without exposing credentials."""
        remote = self.selected_remote()
        if not remote:
            self.notice("Selecione uma conta antes de verificar.", "warning")
            return
        self.verify_generation += 1
        generation = self.verify_generation
        self.verify_button.set_sensitive(False)
        self.account_connection.set_text("Verificando acesso de " + remote + "…")
        threading.Thread(target=self.verify_account_worker,
                         args=(remote, generation), daemon=True).start()

    def verify_account_worker(self, remote, generation):
        try:
            verified = verify_google_remote(remote)
        except (OSError, subprocess.SubprocessError, ValueError):
            verified = False
        GLib.idle_add(self.verify_account_complete, remote, generation, verified)

    def verify_account_complete(self, remote, generation, verified):
        if generation != self.verify_generation or remote != self.selected_remote():
            return False
        self.verify_button.set_sensitive(True)
        if verified:
            self.account_connection.set_text("✓ Acesso ao Google Drive confirmado")
            self.home_accounts.set_text(self.account_display(remote) +
                                        " • acesso confirmado")
            self.notice("Acesso confirmado para a conta " + remote + ".", "success")
        else:
            self.account_connection.set_text("Não foi possível validar o acesso desta conta.")
            self.notice("A conta " + remote +
                        " está configurada, mas a conexão não foi confirmada.", "warning")
        return False

    def selected_remote(self):
        index = self.dropdown.get_selected()
        if index == Gtk.INVALID_LIST_POSITION or index >= self.remotes.get_n_items():
            return None
        return self.remotes.get_string(index)

    def search_remote(self, *_):
        remote = self.selected_remote()
        if not remote:
            self.notice("Selecione uma conta antes de pesquisar.", "warning")
            return
        term = self.search_entry.get_text().strip()
        if len(term) < 2:
            self.notice("Informe pelo menos dois caracteres para pesquisar.", "warning")
            return
        self.browse_generation += 1
        generation = self.browse_generation
        self.files_summary.set_text("Pesquisando arquivos remotos…")
        self.notice("Pesquisando sem transferir arquivos…")
        threading.Thread(target=self.search_remote_worker,
                         args=(remote, term, generation), daemon=True).start()

    def search_remote_worker(self, remote, term, generation):
        try:
            entries = search_files(remote, term)
            GLib.idle_add(self.show_files, entries, generation)
        except (OSError, ValueError, subprocess.SubprocessError) as exc:
            GLib.idle_add(self.show_browse_error, str(exc), generation)

    def browse(self, *_):
        remote = self.selected_remote()
        if not remote:
            self.notice("Conecte uma conta antes de navegar.", "warning")
            return
        self.browse_generation += 1
        generation = self.browse_generation
        if self.pages.get_visible_child_name() == "files":
            self.notice("Consultando a lista de arquivos (sem transferência)…")
        self.files_summary.set_text("Consultando o Google Drive…")
        self.path_label.set_text("Meu Drive" + ((" / " + " / ".join(self.path_parts)) if self.path_parts else ""))
        self.back_button.set_sensitive(bool(self.path_parts))
        threading.Thread(target=self.browse_worker, args=(remote, "/".join(self.path_parts), generation), daemon=True).start()

    def browse_worker(self, remote, relative, generation):
        try:
            entries = list_files(remote, relative)
            GLib.idle_add(self.show_files, entries, generation)
        except (OSError, subprocess.SubprocessError, ValueError) as exc:
            GLib.idle_add(self.show_browse_error, str(exc), generation)

    def show_browse_error(self, message, generation):
        if generation == self.browse_generation:
            if self.pages.get_visible_child_name() == "files":
                self.notice("Falha ao consultar arquivos: " + message, "error")
            self.files_summary.set_text("Não foi possível listar os arquivos.")
        return False

    def show_files(self, entries, generation):
        if generation != self.browse_generation:
            return False
        while current := self.files_list.get_row_at_index(0):
            self.files_list.remove(current)
        for entry in sorted(entries, key=lambda item: (not item["directory"], item["name"].casefold())):
            file_row = Gtk.ListBoxRow()
            file_row.entry_name = entry["name"]
            file_row.is_directory = entry["directory"]
            contents = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            icon = Gtk.Image.new_from_icon_name(
                "folder-symbolic" if entry["directory"] else "text-x-generic-symbolic")
            icon.set_pixel_size(20)
            icon.add_css_class("drive-card-icon")
            contents.append(icon)
            name = label(entry["name"], hexpand=True)
            name.set_ellipsize(3)
            contents.append(name)
            contents.append(label("Pasta" if entry["directory"] else
                                  format_size(entry.get("size", 0)), "drive-muted"))
            file_row.set_child(contents)
            self.files_list.append(file_row)
        self.files_summary.set_text(
            str(len(entries)) + " item(ns). Duplo clique para abrir pastas."
            if entries else "Esta pasta está vazia.")
        if self.pages.get_visible_child_name() == "files" and not self.busy and not self.sync_busy:
            self.notice(str(len(entries)) + " item(ns) listados; nenhum arquivo transferido.", "success")
        return False

    def open_folder(self, _listbox, row):
        if row.is_directory:
            self.path_parts.append(row.entry_name)
            self.browse()

    def go_back(self, *_):
        if self.path_parts:
            self.path_parts.pop()
        self.browse()

    def create_default_folder(self, *_):
        if self.auto_enabled:
            self.notice("Pause a sincronização contínua antes de criar/trocar a pasta.", "warning")
            return
        """Create only the user's explicit default directory after a click."""
        target = Path.home() / "GoogleDrive"
        try:
            if target.exists() and not target.is_dir():
                raise OSError("O caminho existe, mas não é uma pasta.")
            target.mkdir(mode=0o700, exist_ok=True)
            self.folder = target
            self.folder_label.set_text(str(self.folder))
            self.home_folder.set_text(str(self.folder))
            self.persist()
            self.notice("Pasta local pronta: " + str(target), "success")
        except OSError as exc:
            self.notice("Não foi possível criar a pasta: " + str(exc), "error")

    def choose_folder(self, *_):
        if self.auto_enabled:
            self.notice("Pause a sincronização contínua antes de trocar a pasta.", "warning")
            return
        dialog = Gtk.FileChooserNative(title="Escolher pasta local", transient_for=self,
                                      action=Gtk.FileChooserAction.SELECT_FOLDER,
                                      accept_label="Selecionar", cancel_label="Cancelar")
        def response(d, code):
            if code == Gtk.ResponseType.ACCEPT:
                file = d.get_file()
                if file and file.get_path():
                    self.folder = Path(file.get_path())
                    self.folder_label.set_text(str(self.folder))
                    self.home_folder.set_text(str(self.folder))
                    self.preview_generation += 1
                    self.persist()
                    self.notice("Pasta selecionada: " + str(self.folder), "success")
            d.destroy()
        dialog.connect("response", response)
        dialog.show()

    def safe_sync(self, *_):
        if self.auto_enabled:
            self.notice("Pause a sincronização contínua antes de uma cópia manual.", "warning")
            return
        if self.busy or self.sync_busy:
            self.status.set_text("Aguarde a operação atual.")
            return
        remote = self.selected_remote()
        if not remote or not self.folder.is_dir():
            self.status.set_text("Selecione uma conta e pasta local existente.")
            return
        self.sync_busy = True
        self.notice("Transferindo apenas arquivos novos, até 100 por operação…")
        self.sync_report.set_text("Transferência seletiva em andamento…")
        threading.Thread(target=self.safe_sync_worker,
                         args=(remote, self.folder), daemon=True).start()

    def safe_sync_worker(self, remote, folder):
        try:
            plan, completed = execute_additions(remote, folder, dry_run=False)
            message = (str(completed) + " arquivos novos transferidos; " +
                       str(len(plan.conflicts)) + " conflitos preservados.")
        except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as exc:
            message = "Sincronização seletiva interrompida: " + str(exc)
        GLib.idle_add(self.finish_safe_sync, message)

    def finish_safe_sync(self, message):
        self.sync_busy = False
        self.sync_report.set_text(message)
        self.home_sync.set_text(message)
        self.home_activity.set_text(message)
        item = label(datetime.now().strftime("%d/%m %H:%M") + " • " + message, wrap=True)
        self.history.prepend(item)
        self.history_empty.set_visible(False)
        self.notice(message, "error" if "interrompida" in message else "success")
        self.append(message)
        return False

    def preview_sync(self, *_):
        if self.busy or self.sync_busy:
            self.notice("Aguarde a operação atual.", "warning")
            return
        remote = self.selected_remote()
        if not remote or not self.folder.is_dir():
            self.notice("Selecione uma conta e pasta local existente.", "warning")
            return
        self.preview_generation += 1
        generation = self.preview_generation
        self.sync_report.set_text("Analisando arquivos locais e remotos…")
        self.notice("Comparando arquivos sem alterar os dados…")
        threading.Thread(target=self.preview_sync_worker,
                         args=(remote, self.folder, generation), daemon=True).start()

    def preview_sync_worker(self, remote, folder, generation):
        try:
            local = local_inventory(folder)
            cloud = remote_inventory(remote)
            plan = conservative_plan(local, cloud)
            message = (str(len(plan.download)) + " novos para baixar • " +
                       str(len(plan.upload)) + " novos para enviar • " +
                       str(len(plan.conflicts)) + " conflitos. Nenhum arquivo alterado.")
            GLib.idle_add(self.show_sync_plan, generation, message, plan.conflicts)
        except (OSError, ValueError, subprocess.SubprocessError) as exc:
            GLib.idle_add(self.show_sync_plan, generation,
                          "Não foi possível analisar a sincronização: " + str(exc), ())

    def show_sync_plan(self, generation, message, conflicts):
        if generation != self.preview_generation:
            return False
        self.sync_report.set_text(message)
        self.home_sync.set_text(message)
        while current := self.conflicts_list.get_row_at_index(0):
            self.conflicts_list.remove(current)
        if message.startswith("Não foi possível"):
            self.conflicts_list.append(label("A análise não foi concluída.", "drive-muted"))
            self.notice(message, "error")
        elif conflicts:
            for item in conflicts[:50]:
                file_label = label("⚠  " + item, wrap=True)
                self.conflicts_list.append(file_label)
            if len(conflicts) > 50:
                self.conflicts_list.append(label("Mais " + str(len(conflicts) - 50) +
                                                 " conflito(s); consulte os registros."))
            self.notice(message, "warning")
        else:
            self.conflicts_list.append(label("Nenhum conflito identificado.", "drive-muted"))
            self.notice(message, "success" if "Não foi possível" not in message else "error")
        self.append(message)
        return False

    def open_local_folder(self, *_):
        try:
            if not self.folder.is_dir():
                self.notice("Escolha ou crie uma pasta local existente.", "warning")
                return
            Gio.AppInfo.launch_default_for_uri(self.folder.resolve().as_uri(), None)
        except (GLib.Error, OSError) as exc:
            self.status.set_text("Falha ao abrir pasta: " + str(exc))

    def auto_changed(self, switch, *_):
        if self.restoring_auto:
            return
        requested = switch.get_active()
        if requested and (not self.selected_remote() or not self.folder.is_dir()):
            self.notice("Selecione uma conta e uma pasta existente antes de ativar.", "warning")
            self.restoring_auto = True
            switch.set_active(False)
            self.restoring_auto = False
            return
        self.auto_enabled = requested
        self.persist()
        self.auto_info.set_text("Configurando sincronização no Linux…")
        threading.Thread(target=self.background_toggle_worker,
                         args=(requested,), daemon=True).start()

    def background_toggle_worker(self, requested):
        success = False
        try:
            refresh = subprocess.run(["systemctl", "--user", "daemon-reload"],
                                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                     timeout=20)
            if refresh.returncode:
                raise RuntimeError("systemd do usuário indisponível")
            option = "enable" if requested else "disable"
            response = subprocess.run(["systemctl", "--user", option, "--now",
                                        "gdrive-linux-sync.timer"],
                                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                       timeout=30)
            if response.returncode:
                raise RuntimeError("Não foi possível configurar a sincronização automática")
            success = True
            message = ("Sincronização contínua ativada. O serviço funciona com a janela fechada."
                       if requested else "Sincronização contínua desativada.")
        except (OSError, RuntimeError, subprocess.SubprocessError) as exc:
            message = str(exc)
        GLib.idle_add(self.background_toggle_complete, requested, success, message)

    def background_toggle_complete(self, requested, success, message):
        if self.auto_switch.get_active() != requested:
            return False
        if requested and not success:
            self.auto_enabled = False
            self.restoring_auto = True
            self.auto_switch.set_active(False)
            self.restoring_auto = False
            self.persist()
        self.auto_info.set_text(message)
        self.notice(message, "success" if success else "warning")
        self.update_background_status()
        return False

    def run_background_now(self, *_):
        if not self.auto_enabled:
            self.notice("Ative a sincronização contínua para sincronizar agora.", "warning")
            return
        self.auto_info.set_text("Sincronização iniciada pelo serviço do Linux…")
        threading.Thread(target=self.run_background_now_worker, daemon=True).start()

    def run_background_now_worker(self):
        try:
            response = subprocess.run(
                ["systemctl", "--user", "start", "gdrive-linux-sync.service"],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=1100)
            success = response.returncode == 0
        except (OSError, subprocess.SubprocessError):
            success = False
        GLib.idle_add(self.finish_background_now, success)

    def finish_background_now(self, success):
        self.update_background_status()
        self.notice("Verificação de sincronização concluída."
                    if success else "O serviço não concluiu a sincronização. Verifique o status.",
                    "success" if success else "warning")
        return False

    def update_background_status(self, *_):
        status = read_json(STATE_BASE / "latest.json")
        state = status.get("state")
        if not self.auto_enabled:
            message = "Pausada. Nenhum ciclo automático programado."
        elif state == "ok":
            message = (str(status.get("copied", 0)) +
                       " arquivo(s) no último ciclo. " + str(status.get("time", "")))
        elif state == "conflicts":
            message = (str(status.get("conflicts", 0)) +
                       " conflito(s) pendente(s). " + str(status.get("time", "")))
        elif state == "error":
            message = "A última verificação falhou. Revise a conexão e a pasta."
        else:
            message = "Agendada; aguardando o primeiro ciclo do systemd."
        self.background_status.set_text(message)
        return False

