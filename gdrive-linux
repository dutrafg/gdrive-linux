#!/usr/bin/python3
"""Drive para Linux — GTK4 frontend for rclone."""
import subprocess
import threading
from pathlib import Path
import gi
gi.require_version("Gtk", "4.0")
from gi.repository import Gtk, GLib
from rclone_backend import list_remotes, copy_command

VERSION = "0.2.1"

class DriveWindow(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Drive para Linux")
        self.set_default_size(720, 500)
        self.proc = None
        self.busy = False
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        root.set_margin_top(20)
        root.set_margin_bottom(20)
        root.set_margin_start(20)
        root.set_margin_end(20)
        self.set_child(root)

        heading = Gtk.Label(label="Drive para Linux")
        heading.set_xalign(0)
        heading.add_css_class("title-1")
        root.append(heading)
        subtitle = Gtk.Label(label="Google Drive com rclone • v" + VERSION)
        subtitle.set_xalign(0)
        root.append(subtitle)

        row = Gtk.Box(spacing=8)
        root.append(row)
        row.append(Gtk.Label(label="Conta"))
        self.remotes = Gtk.StringList.new([])
        self.dropdown = Gtk.DropDown(model=self.remotes)
        self.dropdown.set_hexpand(True)
        row.append(self.dropdown)
        refresh = Gtk.Button(label="Atualizar")
        refresh.connect("clicked", self.refresh)
        row.append(refresh)
        config = Gtk.Button(label="Configurar")
        config.connect("clicked", self.configure)
        row.append(config)

        folderrow = Gtk.Box(spacing=8)
        root.append(folderrow)
        folderrow.append(Gtk.Label(label="Pasta local"))
        self.folder = Path.home() / "GoogleDrive"
        self.folder_label = Gtk.Label(label=str(self.folder))
        self.folder_label.set_hexpand(True)
        self.folder_label.set_xalign(0)
        self.folder_label.set_ellipsize(3)
        folderrow.append(self.folder_label)
        choose = Gtk.Button(label="Escolher…")
        choose.connect("clicked", self.choose_folder)
        folderrow.append(choose)

        actions = Gtk.Box(spacing=8)
        root.append(actions)
        self.download = Gtk.Button(label="Baixar da nuvem")
        self.download.connect("clicked", self.transfer, "download")
        actions.append(self.download)
        self.upload = Gtk.Button(label="Enviar para nuvem")
        self.upload.connect("clicked", self.transfer, "upload")
        actions.append(self.upload)
        self.cancel_button = Gtk.Button(label="Cancelar")
        self.cancel_button.set_sensitive(False)
        self.cancel_button.connect("clicked", self.cancel)
        actions.append(self.cancel_button)

        self.status = Gtk.Label(label="Pronto. Transferências não excluem arquivos automaticamente.")
        self.status.set_xalign(0)
        self.status.set_wrap(True)
        root.append(self.status)
        scroll = Gtk.ScrolledWindow()
        scroll.set_vexpand(True)
        root.append(scroll)
        self.log = Gtk.TextView()
        self.log.set_editable(False)
        self.log.set_monospace(True)
        scroll.set_child(self.log)
        self.refresh()

    def choose_folder(self, *_):
        dialog = Gtk.FileChooserNative(title="Escolher pasta local", transient_for=self,
                                      action=Gtk.FileChooserAction.SELECT_FOLDER,
                                      accept_label="Selecionar", cancel_label="Cancelar")
        def response(d, code):
            if code == Gtk.ResponseType.ACCEPT:
                file = d.get_file()
                if file and file.get_path():
                    self.folder = Path(file.get_path())
                    self.folder_label.set_text(str(self.folder))
            d.destroy()
        dialog.connect("response", response)
        dialog.show()

    def configure(self, *_):
        try:
            subprocess.Popen(["x-terminal-emulator", "-e", "rclone", "config"])
            self.status.set_text("Configure a conta no terminal e clique em Atualizar.")
        except OSError:
            self.status.set_text("Abra um terminal e execute: rclone config")

    def refresh(self, *_):
        try:
            names = list_remotes()
            self.remotes.splice(0, self.remotes.get_n_items(), names)
            if names:
                self.dropdown.set_selected(0)
            else:
                self.status.set_text("Nenhuma conta configurada. Clique em Configurar.")
        except (OSError, subprocess.SubprocessError) as exc:
            self.status.set_text("Não foi possível consultar o rclone: " + str(exc))

    def append(self, line):
        buf = self.log.get_buffer()
        buf.insert(buf.get_end_iter(), line + "\n")
        return False

    def transfer(self, _button, direction):
        if self.busy:
            return
        index = self.dropdown.get_selected()
        if index == Gtk.INVALID_LIST_POSITION or index >= self.remotes.get_n_items():
            self.status.set_text("Configure uma conta primeiro.")
            return
        remote = self.remotes.get_string(index) + ":"
        local = str(self.folder)
        src, dst = (remote, local) if direction == "download" else (local, remote)
        try:
            command = copy_command(self.remotes.get_string(index), local, direction)
        except ValueError as exc:
            self.status.set_text(str(exc))
            return
        self.busy = True
        self.download.set_sensitive(False)
        self.upload.set_sensitive(False)
        self.cancel_button.set_sensitive(True)
        self.status.set_text("Transferência em andamento…")
        threading.Thread(target=self.worker, args=(command,), daemon=True).start()

    def worker(self, command):
        try:
            self.proc = subprocess.Popen(
                command,
                stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)
            for line in self.proc.stdout:
                GLib.idle_add(self.append, line.rstrip())
            code = self.proc.wait()
            GLib.idle_add(self.status.set_text,
                          "Transferência concluída." if code == 0 else f"Transferência encerrada (código {code}).")
        except OSError as exc:
            GLib.idle_add(self.status.set_text, str(exc))
        finally:
            self.proc = None
            GLib.idle_add(self.finish)

    def finish(self):
        self.busy = False
        self.download.set_sensitive(True)
        self.upload.set_sensitive(True)
        self.cancel_button.set_sensitive(False)
        return False

    def cancel(self, *_):
        if self.proc is not None:
            self.proc.terminate()

class DriveApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="io.github.dutrafg.gdrivelinux")

    def do_activate(self):
        window = self.props.active_window or DriveWindow(self)
        window.present()

if __name__ == "__main__":
    raise SystemExit(DriveApp().run())
